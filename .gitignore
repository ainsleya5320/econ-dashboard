data/ai/silicon-data-marks.json
# Tightening monitor: 6h feed cache (re-derivable from FRED + Treasury FiscalData)
tightening.json
# Trade flows: 12h feed cache (re-derivable; data/fx/invoicing.json is the tracked reference table)
trade-flows.json
# Special situations digest: local preview and run memory (the Actions job keeps its own in the cache)
special-digest-preview.html
state/
# Market map: 24h feed cache (data/seeds/market-map-annual.json is the tracked annual half)
market-map.json
# Long run: 12h feed cache (data/seeds/long-run-history.json is the tracked history)
long-run.json
# News Desk (server/newsDesk/): the stored items, the brief and run log, the daily Claude spend and
# the watchlist's company profiles. They name the watchlist, so they stay on this machine. The
# patterns cover their temp files (.tmp-*) and set-aside copies (.corrupt-*) too.
/news-desk*.json
/news-usage*.json
/news-profile*.json
# the X reader's settings (the cashtags it searches, the monthly cap) and its spend and since_id
/news-x*.json
/news-*.tmp
# a temp file left only if the server dies while appending an approved News Desk row to a data/ai table
/data/ai/*.tmp-*.json
# Options → Market (server/optionsMarket.js): the last option scan with its realized-vol cache, the
# daily per-name IV/skew/put-call archive and the Cboe index-history cache. The first two name the
# watchlist, so all stay on this machine (the pattern covers their .tmp files too).
# data/options/cboe-put-call.json is the tracked, market-wide put/call archive.
/options-market*
/data/options/*.tmp
# CEF discounts (server/cefDiscounts.js): the CEFConnect snapshot, weekly price/NAV and distribution
# history and the daily price/NAV archive. CEFConnect (Nuveen/Morningstar) data is licensed and this
# repo is public: never commit any of it. The pattern covers the .tmp and .corrupt-* files too.
/cef-*
# Nebius spot (server/nebiusSpot.js): the 30-minute feed cache; data/ai/nebius-spot-daily.json is the tracked daily archive
/nebius-spot.json
# GPU futures (server/gpuFutures.js): the CME settlement archive. CME's terms are personal use only and
# this repo is public, so it never gets committed (nor published by the Netlify fork)
/gpu-futures.json
# GPU hyperscalers and market data (server/gpuHyperscalers.js, server/gpuMarketData.js): full-response caches;
# the tracked daily summaries live in data/ai/
/gpu-hyperscalers.json
/gpu-market-data*
# Share of the world, biggest company ÷ GDP, China monitor (server/shareOfWorld.js, topCompanyGdp.js,
# chinaMonitor.js): full-response caches; the share-of-world seeds in data/seeds/ are tracked
/share-of-world.json
/top-company-gdp.json*
/china-monitor.json
/dark-output.json
/global-housing.json
/policy-rates.json
/world-economy.json
/oil-market.json
/cot-report.json
/ai-buildout.json
/magic-formula.json
